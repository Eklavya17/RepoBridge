{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repobridge.scout_request/v1",
  "title": "ScoutRequest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "repobridge.scout_request/v1"
    },
    "order_id": {
      "type": "string"
    },
    "investigation_id": {
      "type": "string"
    },
    "question": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "slot_property",
            "cost_property",
            "access_property"
          ]
        },
        "entity": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "entity",
        "slot",
        "property"
      ],
      "additionalProperties": false,
      "description": "One atomic question: one entity, one slot, one property."
    },
    "budget": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false,
      "description": "Budget(input_tokens: int, output_tokens: int)"
    },
    "bundle_ref": {
      "type": "string"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer_schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "order_id",
    "investigation_id",
    "question",
    "budget",
    "bundle_ref"
  ],
  "additionalProperties": false,
  "description": "A work order: one question, a budget, and a reference to its context bundle."
}
